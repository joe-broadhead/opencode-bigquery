{
  "name": "@joe-broadhead/opencode-bigquery",
  "version": "0.0.1",
  "private": true,
  "description": "Unofficial OpenCode plugin for Google BigQuery",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "bigquery",
    "google-cloud"
  ],
  "homepage": "https://github.com/joe-broadhead/opencode-bigquery#readme",
  "bugs": {
    "url": "https://github.com/joe-broadhead/opencode-bigquery/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-broadhead/opencode-bigquery.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./tui": {
      "default": "./dist/tui.js"
    },
    "./icon.svg": "./assets/icon.svg",
    "./icon-128.png": "./assets/icon-128.png",
    "./icon-256.png": "./assets/icon-256.png"
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "assets/icon-128.png",
    "assets/icon-256.png",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs typecheck",
    "build": "node scripts/check.mjs build",
    "test": "node scripts/check.mjs unit",
    "conformance": "node scripts/check.mjs conformance",
    "test:kit": "node scripts/check.mjs kit",
    "test:host": "node scripts/check.mjs host",
    "test:pack": "node scripts/check.mjs pack",
    "lint": "node scripts/check-forbidden.mjs --self-test && node scripts/check.mjs forbidden copies",
    "icons": "node scripts/check.mjs icons",
    "capture": "node scripts/capture-tools.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/client": "2.2.3",
    "@opencode/plugin": "2.2.3",
    "@opencode/sdk": "2.2.3",
    "@opentui/core": "0.8.0",
    "@opentui/solid": "0.8.0",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@we-the-rebel-alliance/source-contract": "github:we-the-rebel-alliance/source-contract#v0.3.0",
    "babel-preset-solid": "1.9.16",
    "esbuild": "0.28.2",
    "google-auth-library": "11.3.4",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "opencode": {
    "host": ">=2.2.3 <2.4.0",
    "icons": [
      {
        "src": "assets/icon.svg",
        "mimeType": "image/svg+xml",
        "sizes": [
          "any"
        ]
      },
      {
        "src": "assets/icon-128.png",
        "mimeType": "image/png",
        "sizes": [
          "128x128"
        ]
      },
      {
        "src": "assets/icon-256.png",
        "mimeType": "image/png",
        "sizes": [
          "256x256"
        ]
      }
    ],
    "vendor": {
      "id": "bigquery",
      "name": "Google BigQuery",
      "domain": "cloud.google.com"
    }
  },
  "jelly": {
    "title": "BigQuery",
    "summary": "Find, estimate and query your BigQuery data, with a cost cap on every query.",
    "icon": "assets/icon.svg",
    "cost": "Google bills queries to your billing project: on demand about $6.25 per TiB scanned, first TiB a month free; cached reads are free. Each query is capped (10 GiB unless raised, a saved query 1 GiB a read); AI/ML functions, Python UDFs and remote functions bill outside that cap and need a plan.",
    "admin": "grant you BigQuery Job User on a billing project and Data Viewer on the datasets you read, and allow this OAuth client if your organisation restricts Google sign-ins",
    "tools": [
      {
        "name": "bigquery.status",
        "permission": "bigquery.status",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.list",
        "permission": "bigquery.list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.table",
        "permission": "bigquery.table",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.search",
        "permission": "bigquery.search",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.estimate",
        "permission": "bigquery.estimate",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.query",
        "permission": "bigquery.query",
        "effect": "allow",
        "readOnly": true,
        "note": "Runs SELECT and ASSERT under a byte cap. One the cap cannot bound runs from a plan: under Allowed without asking, limited to 120 seconds and your budget if set; otherwise you are asked first"
      },
      {
        "name": "bigquery.job",
        "permission": "bigquery.job",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.jobs",
        "permission": "bigquery.jobs",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.profile",
        "permission": "bigquery.profile",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.plan",
        "permission": "bigquery.plan",
        "effect": "allow",
        "readOnly": true,
        "note": "Dry-runs a change and returns a preview and a single-use plan; changes nothing"
      },
      {
        "name": "bigquery.events_list",
        "permission": "bigquery.events_list",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.saved_read",
        "permission": "bigquery.saved_read",
        "effect": "allow",
        "readOnly": true
      },
      {
        "name": "bigquery.save",
        "permission": "bigquery.save",
        "effect": "allow",
        "readOnly": false,
        "note": "Writes a finished query's results to a local file"
      },
      {
        "name": "bigquery.cancel",
        "permission": "bigquery.cancel",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "bigquery.write",
        "permission": "bigquery.write",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "bigquery.export",
        "permission": "bigquery.export",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "bigquery.share",
        "permission": "bigquery.share",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "bigquery.delete",
        "permission": "bigquery.delete",
        "effect": "allow",
        "readOnly": false,
        "note": "Commits a delete plan: deletes rows, tables or datasets, replaces objects, runs scripts and procedures"
      },
      {
        "name": "bigquery.admin",
        "permission": "bigquery.admin",
        "effect": "allow",
        "readOnly": false
      },
      {
        "name": "bigquery.saved_list",
        "permission": "bigquery.saved_list",
        "effect": "allow",
        "readOnly": true,
        "note": "Lists your saved queries with their SQL and estimates, for a source's set-up; reads no data"
      },
      {
        "name": "bigquery.probe",
        "permission": "bigquery.probe",
        "effect": "allow",
        "readOnly": true,
        "note": "Names the signed-in account for sources; makes no BigQuery call"
      },
      {
        "name": "bigquery.read",
        "permission": "bigquery.read",
        "effect": "allow",
        "readOnly": true,
        "note": "Reads the BigQuery metadata and data a source you bound names; never changes anything"
      }
    ],
    "skills": [
      "opencode-bigquery",
      "opencode-bigquery-sql"
    ],
    "asks": [
      "bigquery.uncapped_read"
    ],
    "rpc": [],
    "views": [],
    "signIns": [
      {
        "id": "google-bigquery",
        "label": "Google Cloud (BigQuery)",
        "integration": "bigquery-*",
        "scopes": [
          "https://www.googleapis.com/auth/bigquery",
          "https://www.googleapis.com/auth/bigquery.insertdata",
          "https://www.googleapis.com/auth/userinfo.email",
          "openid"
        ],
        "relay": {
          "redirectField": "redirectUri",
          "portField": "callbackPort"
        },
        "account": {
          "option": "accounts",
          "label": "Account name",
          "description": "A short name for this Google account, such as work. At Read, Google issues a token that can change BigQuery data wherever your Google account is allowed to; this plugin never uses it to, but a program that can read both OpenCode's credential store and this plugin's key file could. For Google itself to refuse changes, have your admin grant you only BigQuery Job User and Data Viewer.",
          "placeholder": "work",
          "value": {
            "mode": "interactive"
          }
        },
        "hostClient": {
          "id": "google",
          "field": "clientJson",
          "replaces": [
            "clientId",
            "clientSecret"
          ]
        },
        "needed": [
          "AUTH_REQUIRED",
          "AUTH_SCOPE_MISSING"
        ]
      }
    ],
    "contributes": {
      "homeFeeds": [],
      "homeWidgets": [],
      "workKinds": [],
      "settings": [
        {
          "key": "access",
          "label": "Access",
          "type": "string",
          "description": "How much the plugin's tools may do. Generates default rules for agents with a base allow; plan then commit still applies to every change.",
          "choices": [
            {
              "value": "all",
              "label": "Allowed",
              "description": "Every tool runs without asking, reads and changes alike."
            },
            {
              "value": "ask-changes",
              "label": "Ask before changes",
              "description": "Reads run without asking. Each change asks you first."
            },
            {
              "value": "read-only",
              "label": "Read only",
              "description": "Reads run. Changes never run."
            }
          ],
          "default": "all"
        }
      ]
    }
  },
  "sources": {
    "contractVersion": 1,
    "rpc": "google-cloud.bigquery.tools",
    "probe": {
      "action": "bigquery.probe"
    },
    "items": [
      {
        "id": "bigquery.jobs",
        "kind": "events",
        "reads": "x-bigquery/job",
        "tool": "events_list",
        "input": {
          "source": "jobs"
        },
        "accounts": {
          "named": true
        },
        "scope": {
          "keys": [
            "projects"
          ],
          "describe": "Which projects' jobs to read: only jobs you started"
        },
        "permission": {
          "events": "bigquery.events_list",
          "operations": [
            "bigquery.jobs.list"
          ]
        },
        "private": true,
        "cost": {
          "class": "free"
        },
        "maxBytes": 262144,
        "retentionDays": 180,
        "urlHosts": [
          "console.cloud.google.com"
        ]
      },
      {
        "id": "bigquery.saved",
        "kind": "snapshot",
        "tool": "saved_read",
        "input": {
          "source": "saved"
        },
        "output": "table",
        "params": {
          "name": {}
        },
        "accounts": {
          "named": true
        },
        "scope": {
          "keys": [
            "queries"
          ],
          "describe": "Which of your saved queries this reader may run; each is shown with its SQL and its estimate",
          "suggest": {
            "tool": "saved_list",
            "operations": [
              "bigquery.jobs.queryEstimate"
            ]
          }
        },
        "permission": {
          "tool": "bigquery.saved_read",
          "operations": [
            "bigquery.jobs.getQueryResults",
            "bigquery.jobs.query",
            "bigquery.routines.get",
            "bigquery.rowAccessPolicies.list",
            "bigquery.tabledata.list",
            "bigquery.tables.get"
          ]
        },
        "private": true,
        "cost": {
          "class": "billed",
          "units": [
            {
              "per": "tib",
              "usd": 6.25
            }
          ],
          "probe": {
            "per": "call",
            "usd": 0
          }
        },
        "maxAgeSec": 3600,
        "maxBytes": 65536
      }
    ]
  }
}
